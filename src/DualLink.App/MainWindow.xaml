<Window x:Class="DualLink.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DualLink" Width="1100" Height="760" MinWidth="900" MinHeight="620" Background="#08111F" Foreground="#F8FAFC" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F8FAFC"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F8FAFC"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#0F172A"/><Setter Property="Padding" Value="8,5"/><Setter Property="MinWidth" Value="190"/></Style>
    <Style TargetType="Button"><Setter Property="Background" Value="#16263B"/><Setter Property="Foreground" Value="#F8FAFC"/><Setter Property="BorderBrush" Value="#3B526C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="4,0"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#AFC0D0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="15,10"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Border x:Name="TabSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,3" Padding="{TemplateBinding Padding}" Margin="0,0,4,0">
          <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#7DD3FC"/><Setter Property="Background" Value="#123149"/><Setter Property="BorderBrush" Value="#38BDF8"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#E0F2FE"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#1E293B"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="10"/><Setter Property="BorderBrush" Value="#475569"/></Style>
    <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#334155"/><Setter Property="Padding" Value="8"/></Style>
    <Style TargetType="DataGridRow"><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="Background" Value="#111C2E"/><Setter Property="BorderBrush" Value="#334155"/><Style.Triggers><Trigger Property="AlternationIndex" Value="1"><Setter Property="Background" Value="#17243A"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#075985"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger></Style.Triggers></Style>
  </Window.Resources>
  <TabControl Background="#08111F" BorderThickness="0" Foreground="#F8FAFC" TabStripPlacement="Top">
   <TabItem Header="Dashboard">
    <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,16">
      <StackPanel DockPanel.Dock="Left"><TextBlock FontSize="32" FontWeight="Bold" Text="DualLink"/><TextBlock Foreground="#CBD5E1" FontSize="14" Text="Bonded Ethernet + Wi-Fi + USB tethering for Windows 11"/></StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Prepare Proton config" Click="PrepareWireGuard_Click"/><Button Content="Probe now" Click="ProbeNow_Click"/><Button Content="Restore Windows defaults" Click="Restore_Click"/></StackPanel>
    </DockPanel>
    <Border Grid.Row="1" Background="#132238" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
      <StackPanel>
        <WrapPanel VerticalAlignment="Center">
          <TextBlock FontWeight="Bold" Margin="0,7,8,0" Text="Preferred connection:"/>
          <ComboBox x:Name="PreferredCombo" DisplayMemberPath="DisplayName" SelectionChanged="PreferredCombo_SelectionChanged" Margin="0,0,22,0"/>
          <CheckBox x:Name="AutoCheck" Content="Manage routes automatically" IsChecked="True" Margin="0,0,22,0"/>
          <CheckBox x:Name="ProtonModeCheck" Content="Proton-safe gaming mode" IsChecked="True"/>
        </WrapPanel>
        <WrapPanel Margin="0,12,0,0">
          <TextBlock FontWeight="Bold" Margin="0,7,8,0" Text="Bonding relay:"/>
          <TextBox x:Name="RelayAddressText" Width="150" Padding="8,5" Text="63.188.146.220" Background="#FFFFFF" Foreground="#0F172A" Margin="0,0,10,0"/>
          <TextBlock Margin="0,7,8,0" Text="Key:"/>
          <PasswordBox x:Name="RelayKeyBox" Width="240" Padding="8,5" Background="#FFFFFF" Foreground="#0F172A" Margin="0,0,10,0"/>
          <ComboBox x:Name="BondingModeCombo" Width="130" Margin="0,0,10,0">
            <ComboBoxItem Content="Bonding" IsSelected="True"/><ComboBoxItem Content="Failover"/><ComboBoxItem Content="Redundant"/>
          </ComboBox>
          <Button x:Name="ServerSetupButton" Content="Setup server" Click="SetupServer_Click" Padding="14,6" Margin="0,0,8,0"/>
          <Button x:Name="BondingToggleButton" Content="Start bonding" Click="BondingToggle_Click" Padding="14,6"/>
        </WrapPanel>
        <StackPanel x:Name="ServerSetupProgressPanel" Visibility="Collapsed" Margin="0,12,0,0">
          <TextBlock x:Name="ServerSetupProgressText" Text="Setting up relay…" Foreground="#7DD3FC" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <ProgressBar IsIndeterminate="True" Height="8" Foreground="#38BDF8" Background="#24344D"/>
        </StackPanel>
        <WrapPanel Margin="0,12,0,0">
          <Border Background="#0F1B2D" BorderBrush="#475569" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,10,0">
            <TextBlock x:Name="ServerStateText" Text="Server: Not configured" Foreground="#CBD5E1" FontWeight="Bold"/>
          </Border>
          <Border Background="#0F1B2D" BorderBrush="#475569" BorderThickness="1" CornerRadius="6" Padding="10,6">
            <TextBlock x:Name="BondingStateText" Text="Bonding: Stopped" Foreground="#CBD5E1" FontWeight="Bold"/>
          </Border>
          <Border Background="#0F1B2D" BorderBrush="#475569" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="10,0,0,0">
            <TextBlock x:Name="RelayLatencyText" Text="Relay latency: Not connected" Foreground="#CBD5E1" FontWeight="Bold"/>
          </Border>
        </WrapPanel>
      </StackPanel>
    </Border>
    <Border Grid.Row="2" Background="#132238" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Ellipse x:Name="StatusDot" Grid.Column="0" Width="13" Height="13" Fill="#F59E0B" Margin="0,2,10,0" VerticalAlignment="Top"/>
        <StackPanel Grid.Column="1"><TextBlock x:Name="StatusText" FontSize="15" FontWeight="SemiBold" Text="Starting network monitor…" TextWrapping="Wrap"/><TextBlock x:Name="VpnText" Margin="0,4,0,0" Foreground="#FDE68A" FontSize="13" TextWrapping="Wrap"/></StackPanel>
        <TextBlock x:Name="ActiveText" Grid.Column="2" Margin="14,0,0,0" Foreground="#7DD3FC" FontWeight="Bold" FontSize="15"/>
      </Grid>
    </Border>
    <DataGrid Grid.Row="3" x:Name="AdapterGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" AlternationCount="2" Background="#111C2E" Foreground="#FFFFFF" GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderBrush="#334155" BorderThickness="1" SelectionUnit="FullRow">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Connection" Binding="{Binding Name}" Width="2*"/>
        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*"/>
        <DataGridTextColumn Header="IP address" Binding="{Binding Address}" Width="1.4*"/>
        <DataGridTextColumn Header="Ping" Binding="{Binding Latency}" Width="*"/>
        <DataGridTextColumn Header="Relay ping" Binding="{Binding RelayLatency}" Width="*"/>
        <DataGridTextColumn Header="Jitter" Binding="{Binding Jitter}" Width="*"/>
        <DataGridTextColumn Header="Loss" Binding="{Binding Loss}" Width="*"/>
        <DataGridTextColumn Header="Quality (0–100)" Binding="{Binding Score}" Width="1.2*"/>
        <DataGridTextColumn Header="Upload" Binding="{Binding Upload}" Width="1.35*"/>
        <DataGridTextColumn Header="Download" Binding="{Binding Download}" Width="1.35*"/>
        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>
    <Border Grid.Row="4" Margin="0,14,0,0" Padding="12" Background="#3B2A12" BorderBrush="#A16207" BorderThickness="1" CornerRadius="8">
      <TextBlock Foreground="#FEF3C7" Text="Bonding mode sends traffic through the DualLink relay so games keep one public IP while Ethernet, Wi-Fi hotspot, and USB tethering contribute simultaneously. Existing Proton-safe failover remains available when bonding is stopped." TextWrapping="Wrap"/>
    </Border>
    </Grid>
   </TabItem>
   <TabItem Header="History &amp; charts">
    <Grid Margin="22">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="220"/></Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="HistoryChartTitle" FontSize="24" FontWeight="SemiBold" Text="Connection quality"/>
          <TextBlock x:Name="HistoryChartDescription" Foreground="#AFC0D0" Margin="0,4,0,0" Text="Health score: 100 is excellent and 0 is unusable; based on ping, jitter, loss, and reliability." TextWrapping="Wrap"/>
        </StackPanel>
        <WrapPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="18,0,0,0">
          <StackPanel Margin="0,0,10,0"><TextBlock Foreground="#AFC0D0" FontSize="12" Margin="0,0,0,4" Text="Chart"/><ComboBox x:Name="HistoryMetricCombo" MinWidth="140" SelectionChanged="HistoryChartSelectionChanged"><ComboBoxItem Content="Quality" Tag="Quality" IsSelected="True"/><ComboBoxItem Content="Ping" Tag="Ping"/><ComboBoxItem Content="Download" Tag="Download"/><ComboBoxItem Content="Upload" Tag="Upload"/></ComboBox></StackPanel>
          <StackPanel Margin="0,0,10,0"><TextBlock Foreground="#AFC0D0" FontSize="12" Margin="0,0,0,4" Text="Time range"/><ComboBox x:Name="HistoryRangeCombo" MinWidth="150" SelectionChanged="HistoryChartSelectionChanged"><ComboBoxItem Content="Last 15 minutes" Tag="15" IsSelected="True"/><ComboBoxItem Content="Last 30 minutes" Tag="30"/><ComboBoxItem Content="Last hour" Tag="60"/></ComboBox></StackPanel>
          <Button Content="Export data…" Click="ExportHistory_Click" VerticalAlignment="Bottom"/>
          <Button Content="Clear history" Click="ClearHistory_Click" VerticalAlignment="Bottom"/>
        </WrapPanel>
      </Grid>
      <Border Grid.Row="1" Background="#0F1B2D" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12">
        <Grid>
          <TextBlock x:Name="HistoryAxisText" Text="Score (0–100)" Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="1" Margin="0,2,6,0"/>
          <Canvas x:Name="HistoryCanvas" Background="#0B1525" SizeChanged="HistoryCanvas_SizeChanged"/>
          <TextBlock x:Name="HistoryEmptyText" Text="Collecting connection history…" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
        </Grid>
      </Border>
      <DataGrid Grid.Row="2" x:Name="HistoryEventGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="#111C2E" Foreground="#FFFFFF" BorderBrush="#334155" HeadersVisibility="Column">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="1.3*"/>
          <DataGridTextColumn Header="Connection" Binding="{Binding Connection}" Width="1.3*"/>
          <DataGridTextColumn Header="Event" Binding="{Binding Event}" Width="1.4*"/>
          <DataGridTextColumn Header="Outage duration" Binding="{Binding Duration}" Width="*"/>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
   </TabItem>
  </TabControl>
</Window>
