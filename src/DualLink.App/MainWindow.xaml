<Window x:Class="DualLink.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DualLink" Width="1080" Height="800" MinWidth="920" MinHeight="650" Background="#071321" Foreground="#EDF6FF" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EDF6FF"/></Style>
    <Style TargetType="Button"><Setter Property="Background" Value="#15263A"/><Setter Property="Foreground" Value="#EDF6FF"/><Setter Property="BorderBrush" Value="#3B526C"/><Setter Property="Padding" Value="13,8"/><Setter Property="Margin" Value="4,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="38"/></Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#159FD0"/><Setter Property="BorderBrush" Value="#159FD0"/><Setter Property="Foreground" Value="#04131B"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#DCE9F5"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#0B1929"/><Setter Property="Foreground" Value="#EDF6FF"/><Setter Property="BorderBrush" Value="#38506A"/><Setter Property="Padding" Value="9,7"/><Setter Property="MinHeight" Value="38"/></Style>
    <Style TargetType="PasswordBox"><Setter Property="Background" Value="#0B1929"/><Setter Property="Foreground" Value="#EDF6FF"/><Setter Property="BorderBrush" Value="#38506A"/><Setter Property="Padding" Value="9,7"/><Setter Property="MinHeight" Value="38"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Background" Value="#0B1929"/><Setter Property="Foreground" Value="#EDF6FF"/><Setter Property="BorderBrush" Value="#38506A"/><Setter Property="Padding" Value="8,6"/><Setter Property="MinHeight" Value="38"/></Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Background" Value="#0B1929"/><Setter Property="Foreground" Value="#EDF6FF"/><Setter Property="Padding" Value="8,6"/></Style>
    <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TabPanel Grid.Row="0" IsItemsHost="True" Background="Transparent" Margin="20,0"/><Border Grid.Row="1" BorderBrush="#2B4057" BorderThickness="0,1,0,0"><ContentPresenter ContentSource="SelectedContent"/></Border></Grid></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TabItem"><Setter Property="Foreground" Value="#AFC0D0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="15,11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,3" Padding="{TemplateBinding Padding}" Margin="0,0,4,0"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#6EDCFF"/><Setter Property="Background" Value="#123149"/><Setter Property="BorderBrush" Value="#23BDE8"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#E0F2FE"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#132338"/><Setter Property="Foreground" Value="#AFC0D0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="10"/><Setter Property="BorderBrush" Value="#2B4057"/></Style>
    <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="#EDF6FF"/><Setter Property="BorderBrush" Value="#233A51"/><Setter Property="Padding" Value="9"/></Style>
    <Style TargetType="DataGridRow"><Setter Property="Foreground" Value="#EDF6FF"/><Setter Property="Background" Value="#0C1B2C"/><Style.Triggers><Trigger Property="AlternationIndex" Value="1"><Setter Property="Background" Value="#102034"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#123149"/></Trigger></Style.Triggers></Style>
  </Window.Resources>
  <Grid Margin="18"><Border Background="#091728" BorderBrush="#2A4058" BorderThickness="1" CornerRadius="12"><Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#172538" CornerRadius="11,11,0,0" Padding="14,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="22" Height="22" Background="#2DD4BF" CornerRadius="6"><TextBlock Text="D" Foreground="#062033" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="DualLink" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel></Border>
    <Grid Grid.Row="1" Margin="20,18,20,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="30" FontWeight="SemiBold" Text="DualLink"/><TextBlock Foreground="#A9BBCC" Margin="0,4,0,0" Text="Bonded Ethernet + Wi-Fi + USB tethering for Windows 11"/></StackPanel><WrapPanel Grid.Column="1" VerticalAlignment="Bottom"><Button Content="Prepare Proton config" Click="PrepareWireGuard_Click"/><Button Content="Probe now" Click="ProbeNow_Click"/><Button Content="Restore defaults" Click="Restore_Click"/><Button x:Name="BondingToggleButton" Style="{StaticResource PrimaryButton}" Content="Start bonding" Click="BondingToggle_Click"/></WrapPanel></Grid>
    <TabControl Grid.Row="2">
      <TabItem Header="Dashboard"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="20,16,20,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#102238" CornerRadius="9" Padding="14"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,10,0"><TextBlock Foreground="#AFC0D0" FontSize="12" Text="Preferred connection" Margin="0,0,0,5"/><ComboBox x:Name="PreferredCombo" DisplayMemberPath="DisplayName" SelectionChanged="PreferredCombo_SelectionChanged"/></StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Foreground="#AFC0D0" FontSize="12" Text="Bonding relay" Margin="0,0,0,5"/><TextBox x:Name="RelayAddressText" Text="63.188.146.220"/></StackPanel>
          <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Foreground="#AFC0D0" FontSize="12" Text="Mode" Margin="0,0,0,5"/><ComboBox x:Name="BondingModeCombo"><ComboBoxItem Content="Bonding" IsSelected="True"/><ComboBoxItem Content="Failover"/><ComboBoxItem Content="Redundant"/></ComboBox></StackPanel><Button Grid.Column="3" x:Name="ServerSetupButton" Content="Setup server" Click="SetupServer_Click" VerticalAlignment="Bottom" Margin="0"/></Grid>
          <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Relay key" Foreground="#AFC0D0" VerticalAlignment="Center" Margin="0,0,8,0"/><PasswordBox Grid.Column="1" x:Name="RelayKeyBox"/><WrapPanel Grid.Column="2" Margin="18,0,0,0" VerticalAlignment="Center"><CheckBox x:Name="AutoCheck" Content="Manage routes automatically" IsChecked="True" Margin="0,0,20,0"/><CheckBox x:Name="ProtonModeCheck" Content="Proton-safe gaming mode" IsChecked="True"/></WrapPanel></Grid>
          <StackPanel x:Name="ServerSetupProgressPanel" Visibility="Collapsed" Margin="0,12,0,0"><TextBlock x:Name="ServerSetupProgressText" Text="Setting up relay…" Foreground="#6EDCFF" FontWeight="SemiBold" Margin="0,0,0,6"/><ProgressBar IsIndeterminate="True" Height="7" Foreground="#23BDE8" Background="#24344D"/></StackPanel>
          <WrapPanel Margin="0,12,0,0"><TextBlock x:Name="ServerStateText" Text="Server: Not configured" Foreground="#AFC0D0" FontWeight="SemiBold" Margin="0,0,18,0"/><TextBlock x:Name="BondingStateText" Text="Bonding: Stopped" Foreground="#AFC0D0" FontWeight="SemiBold" Margin="0,0,18,0"/><TextBlock x:Name="RelayLatencyText" Text="Relay latency: Not connected" Foreground="#AFC0D0" FontWeight="SemiBold"/></WrapPanel></StackPanel></Border>
        <Border Grid.Row="1" Background="#102C2A" BorderBrush="#2ACB84" BorderThickness="4,0,0,0" CornerRadius="7" Padding="13" Margin="0,13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#2ACB84" VerticalAlignment="Top" Margin="0,3,10,0"/><StackPanel Grid.Column="1"><TextBlock x:Name="StatusText" FontWeight="SemiBold" Text="Starting network monitor…" TextWrapping="Wrap"/><TextBlock x:Name="VpnText" Foreground="#5DE3A7" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel><TextBlock x:Name="ActiveText" Grid.Column="2" Foreground="#6EDCFF" FontWeight="SemiBold" Margin="14,0,0,0"/></Grid></Border>
        <DataGrid Grid.Row="2" x:Name="AdapterGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" AlternationCount="2" Background="#0C1B2C" Foreground="#EDF6FF" GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderBrush="#2B4057" BorderThickness="1" SelectionUnit="FullRow" MinHeight="205"><DataGrid.Columns><DataGridTextColumn Header="Connection" Binding="{Binding Name}" Width="1.4*"/><DataGridTextColumn Header="Ping" Binding="{Binding Latency}" Width="*"/><DataGridTextColumn Header="Relay ping" Binding="{Binding RelayLatency}" Width="*"/><DataGridTextColumn Header="Jitter" Binding="{Binding Jitter}" Width="*"/><DataGridTextColumn Header="Loss" Binding="{Binding Loss}" Width="*"/><DataGridTextColumn Header="Quality (0–100)" Binding="{Binding Score}" Width="1.2*"/><DataGridTextColumn Header="Download now" Binding="{Binding Download}" Width="1.5*"/><DataGridTextColumn Header="Upload now" Binding="{Binding Upload}" Width="1.5*"/><DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="*"/></DataGrid.Columns></DataGrid>
        <TextBlock Grid.Row="3" Foreground="#9EB1C4" FontSize="12" Margin="0,10,0,0" Text="Traffic counters use Windows adapter byte counters, so download and upload remain visible even when bonding is off." TextWrapping="Wrap"/>
      </Grid></ScrollViewer></TabItem>
      <TabItem Header="History &amp; charts"><Grid Margin="20,16,20,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="210"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="HistoryChartTitle" FontSize="20" FontWeight="SemiBold" Text="Connection quality"/><TextBlock x:Name="HistoryChartDescription" Foreground="#AFC0D0" Margin="0,4,0,0" Text="Health score: 100 is excellent and 0 is unusable; based on ping, jitter, loss, and reliability." TextWrapping="Wrap"/></StackPanel><WrapPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="18,0,0,0"><StackPanel Margin="0,0,10,0"><TextBlock Foreground="#AFC0D0" FontSize="12" Text="Chart" Margin="0,0,0,4"/><ComboBox x:Name="HistoryMetricCombo" MinWidth="135" SelectionChanged="HistoryChartSelectionChanged"><ComboBoxItem Content="Quality" Tag="Quality" IsSelected="True"/><ComboBoxItem Content="Ping" Tag="Ping"/><ComboBoxItem Content="Download" Tag="Download"/><ComboBoxItem Content="Upload" Tag="Upload"/></ComboBox></StackPanel><StackPanel Margin="0,0,10,0"><TextBlock Foreground="#AFC0D0" FontSize="12" Text="Time range" Margin="0,0,0,4"/><ComboBox x:Name="HistoryRangeCombo" MinWidth="145" SelectionChanged="HistoryChartSelectionChanged"><ComboBoxItem Content="Last 15 minutes" Tag="15" IsSelected="True"/><ComboBoxItem Content="Last 30 minutes" Tag="30"/><ComboBoxItem Content="Last hour" Tag="60"/></ComboBox></StackPanel><Button Content="Export data…" Click="ExportHistory_Click" VerticalAlignment="Bottom"/><Button Content="Clear" Click="ClearHistory_Click" VerticalAlignment="Bottom"/></WrapPanel></Grid>
        <Border Grid.Row="1" Background="#0C1B2C" BorderBrush="#2B4057" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,0,0,12"><Grid><TextBlock x:Name="HistoryAxisText" Text="Score (0–100)" Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="1" Margin="0,2,6,0"/><Canvas x:Name="HistoryCanvas" Background="#0B1929" SizeChanged="HistoryCanvas_SizeChanged"/><TextBlock x:Name="HistoryEmptyText" Text="Collecting connection history…" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/></Grid></Border>
        <DataGrid Grid.Row="2" x:Name="HistoryEventGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="#0C1B2C" Foreground="#EDF6FF" BorderBrush="#2B4057" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="1.3*"/><DataGridTextColumn Header="Connection" Binding="{Binding Connection}" Width="1.3*"/><DataGridTextColumn Header="Event" Binding="{Binding Event}" Width="1.4*"/><DataGridTextColumn Header="Outage duration" Binding="{Binding Duration}" Width="*"/></DataGrid.Columns></DataGrid>
      </Grid></TabItem>
    </TabControl>
  </Grid></Border></Grid>
</Window>
