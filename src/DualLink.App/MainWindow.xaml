<Window x:Class="DualLink.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DualLink" Width="940" Height="660" MinWidth="760" MinHeight="520" Background="{StaticResource BackgroundBrush}" Foreground="#E5E7EB" WindowStartupLocation="CenterScreen">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,18">
      <StackPanel DockPanel.Dock="Left"><TextBlock FontSize="30" FontWeight="Bold" Text="DualLink"/><TextBlock Foreground="#94A3B8" Text="Automatic Ethernet + Wi-Fi failover and quality routing"/></StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"><CheckBox x:Name="AutoCheck" Content="Auto optimize" IsChecked="True" VerticalAlignment="Center" Margin="10"/><Button Content="Probe now" Click="ProbeNow_Click"/><Button Content="Restore Windows defaults" Click="Restore_Click"/></StackPanel>
    </DockPanel>
    <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,14">
      <DockPanel><Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="#F59E0B" Margin="0,0,10,0"/><TextBlock x:Name="StatusText" FontSize="15" Text="Starting network monitor…"/><TextBlock x:Name="ActiveText" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/></DockPanel>
    </Border>
    <DataGrid Grid.Row="2" x:Name="AdapterGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="{StaticResource CardBrush}" Foreground="#E5E7EB" RowBackground="#141E30" AlternatingRowBackground="#18253A" GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Connection" Binding="{Binding Name}" Width="2*"/>
        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*"/>
        <DataGridTextColumn Header="IP address" Binding="{Binding Address}" Width="1.4*"/>
        <DataGridTextColumn Header="Ping" Binding="{Binding Latency}" Width="*"/>
        <DataGridTextColumn Header="Jitter" Binding="{Binding Jitter}" Width="*"/>
        <DataGridTextColumn Header="Loss" Binding="{Binding Loss}" Width="*"/>
        <DataGridTextColumn Header="Quality" Binding="{Binding Score}" Width="*"/>
        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>
    <TextBlock Grid.Row="3" Margin="0,14,0,0" Foreground="#94A3B8" Text="DualLink changes only Windows interface metrics. It does not create a VPN, intercept traffic, or combine one game connection across two ISPs." TextWrapping="Wrap"/>
  </Grid>
</Window>
