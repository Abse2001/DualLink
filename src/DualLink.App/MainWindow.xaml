<Window x:Class="DualLink.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DualLink" Width="1040" Height="720" MinWidth="860" MinHeight="580" Background="#08111F" Foreground="#F8FAFC" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F8FAFC"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F8FAFC"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#0F172A"/><Setter Property="Padding" Value="8,5"/><Setter Property="MinWidth" Value="190"/></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#1E293B"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="10"/><Setter Property="BorderBrush" Value="#475569"/></Style>
    <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#334155"/><Setter Property="Padding" Value="8"/></Style>
    <Style TargetType="DataGridRow"><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="Background" Value="#111C2E"/><Setter Property="BorderBrush" Value="#334155"/><Style.Triggers><Trigger Property="AlternationIndex" Value="1"><Setter Property="Background" Value="#17243A"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#075985"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger></Style.Triggers></Style>
  </Window.Resources>
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,16">
      <StackPanel DockPanel.Dock="Left"><TextBlock FontSize="32" FontWeight="Bold" Text="DualLink"/><TextBlock Foreground="#CBD5E1" FontSize="14" Text="Bonded Ethernet + hotspot for Windows 11"/></StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Prepare Proton config" Click="PrepareWireGuard_Click"/><Button Content="Probe now" Click="ProbeNow_Click"/><Button Content="Restore Windows defaults" Click="Restore_Click"/></StackPanel>
    </DockPanel>
    <Border Grid.Row="1" Background="#132238" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
      <StackPanel>
        <WrapPanel VerticalAlignment="Center">
          <TextBlock FontWeight="Bold" Margin="0,7,8,0" Text="Preferred connection:"/>
          <ComboBox x:Name="PreferredCombo" DisplayMemberPath="DisplayName" SelectionChanged="PreferredCombo_SelectionChanged" Margin="0,0,22,0"/>
          <CheckBox x:Name="AutoCheck" Content="Manage routes automatically" IsChecked="True" Margin="0,0,22,0"/>
          <CheckBox x:Name="ProtonModeCheck" Content="Proton-safe gaming mode" IsChecked="True"/>
        </WrapPanel>
        <WrapPanel Margin="0,12,0,0">
          <TextBlock FontWeight="Bold" Margin="0,7,8,0" Text="Bonding relay:"/>
          <TextBox x:Name="RelayAddressText" Width="150" Padding="8,5" Text="63.188.146.220" Background="#FFFFFF" Foreground="#0F172A" Margin="0,0,10,0"/>
          <TextBlock Margin="0,7,8,0" Text="Key:"/>
          <PasswordBox x:Name="RelayKeyBox" Width="240" Padding="8,5" Background="#FFFFFF" Foreground="#0F172A" Margin="0,0,10,0"/>
          <ComboBox x:Name="BondingModeCombo" Width="130" Margin="0,0,10,0">
            <ComboBoxItem Content="Bonding" IsSelected="True"/><ComboBoxItem Content="Failover"/><ComboBoxItem Content="Redundant"/>
          </ComboBox>
          <Button x:Name="BondingToggleButton" Content="Start bonding" Click="BondingToggle_Click" Padding="14,6"/>
        </WrapPanel>
      </StackPanel>
    </Border>
    <Border Grid.Row="2" Background="#132238" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Ellipse x:Name="StatusDot" Grid.Column="0" Width="13" Height="13" Fill="#F59E0B" Margin="0,2,10,0" VerticalAlignment="Top"/>
        <StackPanel Grid.Column="1"><TextBlock x:Name="StatusText" FontSize="15" FontWeight="SemiBold" Text="Starting network monitor…" TextWrapping="Wrap"/><TextBlock x:Name="VpnText" Margin="0,4,0,0" Foreground="#FDE68A" FontSize="13" TextWrapping="Wrap"/></StackPanel>
        <TextBlock x:Name="ActiveText" Grid.Column="2" Margin="14,0,0,0" Foreground="#7DD3FC" FontWeight="Bold" FontSize="15"/>
      </Grid>
    </Border>
    <DataGrid Grid.Row="3" x:Name="AdapterGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" AlternationCount="2" Background="#111C2E" Foreground="#FFFFFF" GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderBrush="#334155" BorderThickness="1" SelectionUnit="FullRow">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Connection" Binding="{Binding Name}" Width="2*"/>
        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*"/>
        <DataGridTextColumn Header="IP address" Binding="{Binding Address}" Width="1.4*"/>
        <DataGridTextColumn Header="Ping" Binding="{Binding Latency}" Width="*"/>
        <DataGridTextColumn Header="Jitter" Binding="{Binding Jitter}" Width="*"/>
        <DataGridTextColumn Header="Loss" Binding="{Binding Loss}" Width="*"/>
        <DataGridTextColumn Header="Quality" Binding="{Binding Score}" Width="*"/>
        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>
    <Border Grid.Row="4" Margin="0,14,0,0" Padding="12" Background="#3B2A12" BorderBrush="#A16207" BorderThickness="1" CornerRadius="8">
      <TextBlock Foreground="#FEF3C7" Text="Bonding mode sends traffic through the DualLink relay so games keep one public IP while Ethernet and hotspot contribute simultaneously. Existing Proton-safe failover remains available when bonding is stopped." TextWrapping="Wrap"/>
    </Border>
  </Grid>
</Window>
